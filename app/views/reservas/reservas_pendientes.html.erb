<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" %>

<div class="bg-light text-dark min-vh-100 py-5">
  <div class="container">
    <header class="text-center mb-4">
      <h2 class="display-6 fw-semibold mb-3">
        <i class="bi bi-journal-text me-2"></i>
        Reservas Pendientes de Aprobación
      </h2>
    </header>

    <!-- TABLA -->
    <div class="table-responsive">
      <table class="table align-middle text-center m-0" style="background-color:#f3f3f3;">
        <thead class="table-secondary text-dark">
          <tr>
            <th><i class="bi bi-check2-square me-1"></i>Reserva ID</th>
            <th><i class="bi bi-envelope me-1"></i>Correo Usuario</th>
            <th><i class="bi bi-building me-1"></i>Espacio</th>
            <th><i class="bi bi-calendar-date me-1"></i>Fecha</th>
            <th><i class="bi bi-clock me-1"></i>Módulo</th>
            <th><i class="bi bi-gear me-1"></i>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% @reservas.each do |reserva_pendiente| %>
            <tr class="fila-gris">
              <td><%= reserva_pendiente.id %></td>
              <td><%= reserva_pendiente.usuario.email %></td>
              <td><%= reserva_pendiente.espacio.nombre %></td>
              <td><%= reserva_pendiente.fecha.strftime('%d/%m/%Y') %></td>
              <td>
                <%= "#{reserva_pendiente.modulo.hora_inicio.strftime('%H:%M')} - #{reserva_pendiente.modulo.hora_fin.strftime('%H:%M')}" %>
              </td>
              <td>
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                  <!-- Botón Aceptar -->
                  <%= button_to "/reservas/aceptar_reserva/#{reserva_pendiente.id}",
                      method: :patch,
                      data: { confirm: "¿Estás seguro?" },
                      class: "btn btn-outline-success btn-sm fw-bold d-flex align-items-center gap-1" do %>
                    <i class="bi bi-check-circle"></i> Aceptar
                  <% end %>

                  <!-- Botón Rechazar (abre modal) -->
                  <button type="button" class="btn btn-outline-danger btn-sm fw-bold d-flex align-items-center gap-1" 
                          data-bs-toggle="modal" data-bs-target="#rechazarModal<%= reserva_pendiente.id %>">
                    <i class="bi bi-x-circle"></i> Rechazar
                  </button>
                </div>
              </td>
            </tr>

            <!-- Modal Rechazo -->
            <div class="modal fade" id="rechazarModal<%= reserva_pendiente.id %>" tabindex="-1" aria-labelledby="rechazarModalLabel<%= reserva_pendiente.id %>" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="rechazarModalLabel<%= reserva_pendiente.id %>">Rechazar Reserva <%= reserva_pendiente.id %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                  </div>
                  <div class="modal-body">
                    <p>Escriba el motivo del rechazo de la reserva:</p>
                    <%= form_with url: rechazar_reserva_path(reserva_pendiente.id), method: :patch, local: true do |f| %>
                      <%= f.text_area :mensaje, class: "form-control mb-3", rows: 3, placeholder: "Motivo del rechazo..." %>
                      <div class="d-flex justify-content-end gap-2">
                        <%= f.submit "Confirmar", class: "btn btn-outline-success btn-sm fw-bold d-flex align-items-center gap-1" %>
                        <button type="button" class="btn btn-outline-danger btn-sm fw-bold d-flex align-items-center gap-1" data-bs-dismiss="modal">Cancelar</button>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" %>