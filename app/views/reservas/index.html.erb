<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" %>

<div class="bg-light text-dark min-vh-100 py-5">
  <style>
    .fila-gris > * {background-color: #f3f3f3  
      !important;}
    .fila-gris:hover > * {background-color: #e8e8e8   
      !important;}
  </style>
    <div class="container">
    <header class="text-center mb-4">
      <h2 class="display-6 fw-semibold mb-3"><i class="bi bi-journal-text me-2"></i>Mis reservas</h2>
    </header>
    
    <!-- TABLA -->
    <div class="table-responsive">
      <table class="table align-middle text-center m-0" style="background-color:#f3f3f3;">

        <thead class="table-secondary text-dark">
          <tr>
            <th><i class="bi bi-building me-1"></i>Espacio</th>
            <th><i class="bi bi-calendar-date me-1"></i>Fecha</th>
            <th><i class="bi bi-clock me-1"></i>Módulo</th>
            <th><i class="bi bi-check2-square me-1"></i>Estado</th>
            <th><i class="bi bi-gear me-1"></i>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% @reservas.each do |reserva| %>
            <tr class="fila-gris">
              
              <td><%= reserva.espacio.nombre %></td>
              <td><%= reserva.fecha.strftime('%d/%m/%Y') %></td>
              <td><%= "#{reserva.modulo.hora_inicio.strftime('%H:%M')} - #{reserva.modulo.hora_fin.strftime('%H:%M')}" %></td>
              <td>
              <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">

                <% estado = reserva.estado.downcase %>
                <span class="badge 
                  <%= case estado
                        when 'pendiente' then 'bg-warning text-dark'
                        when 'confirmada' then 'bg-success'
                        when 'rechazada' then 'bg-danger'
                        when 'cancelada' then 'bg-secondary'
                        else 'bg-light text-dark'
                      end %>">
                  <%= reserva.estado.capitalize %>
                </span>

                <% if reserva.empezada? && !reserva.cancelada? && !reserva.rechazada?%>
                  <span class="badge" style="background-color: #9b59b6; color: white;">
                    Finalizada
                  </span>
                <% end %>

              </div>

              </td>

              <td>
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">

                  <%= link_to reserva_path(reserva), class: "btn btn-outline-primary btn-sm fw-bold d-flex align-items-center gap-1" do %>
                    <i class="bi bi-eye"></i> Ver
                  <% end %>

                  <% unless reserva.empezada? || reserva.cancelada? || reserva.rechazada?%>
                    <% if reserva.editable? %>
                      <%= link_to edit_reserva_path(reserva), class: "btn btn-outline-warning btn-sm fw-bold d-flex align-items-center gap-1" do %>
                        <i class="bi bi-pencil-square"></i> Modificar
                      <% end %>
                    <% end %>

                    <%= button_to cancel_reserva_path(reserva),
                                  method: :patch,
                                  form: { data: { turbo_confirm: "¿Cancelar esta reserva?" } },
                                  class: "btn btn-outline-danger btn-sm fw-bold d-flex align-items-center gap-1" do %>
                      <i class="bi bi-x-circle"></i> Cancelar
                    <% end %>
                    
                    
                  <% else %>
                    <span class="text-muted small fw-semibold">No modificable</span>
                  <% end %>
                </div>

              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Nueva reserva + volver inicio -->
    <div class="text-center mt-4">      
      <%= link_to new_reserva_path, class: "btn btn-primary btn-sm" do %>
        <i class="bi bi-plus-circle me-1"></i>Nueva reserva
      <% end %>
      <%= link_to root_path, class: "btn btn-outline-secondary btn-sm text-dark border-2" do %>
        <i class="bi bi-arrow-left-circle me-1"></i>Volver al inicio
      <% end %>
    </div>
    

  </div>

</div>
<%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" %>
