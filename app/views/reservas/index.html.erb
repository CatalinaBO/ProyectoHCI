<div class="bg-light min-vh-100 py-5">
  <div class="container" style="max-width: 900px;">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <h1 class="h2 fw-bold m-0" style="color:#2c3e50;"><i class="bi bi-journal-text me-2"></i>Mis reservas</h1>
      <%= link_to espacios_path, class: "btn btn-primary btn-sm" do %>
        <i class="bi bi-plus-circle me-1"></i>Nueva reserva
      <% end %>
    </header>

    <% if @grupos.empty? %>
      <div class="tarjeta-reserva p-4 text-center text-muted">
        Aún no tienes reservas. Revisa la <%= link_to "disponibilidad de salas", espacios_path %> para hacer una.
      </div>
    <% else %>
      <div class="d-flex flex-column gap-2">
        <% @grupos.each do |rs| %>
          <%= link_to mi_reserva_path(rs.first.grupo), class: "tarjeta-reserva p-3 text-decoration-none text-reset d-flex flex-wrap justify-content-between align-items-center gap-2" do %>
            <div>
              <div class="fw-semibold"><%= rs.first.espacio.nombre %></div>
              <div class="small text-muted">
                <%= fecha_larga(rs.first.fecha) %> · <%= rango_modulos(rs) %>
                (<%= rs.size %> <%= rs.size == 1 ? "módulo" : "módulos" %>)
              </div>
            </div>
            <div class="d-flex align-items-center gap-3">
              <%= estado_badge(estado_grupo(rs)) %>
              <span class="small fw-semibold text-primary">Ver mi reserva <i class="bi bi-chevron-right"></i></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
