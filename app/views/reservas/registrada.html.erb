<div class="bg-light min-vh-100 py-5">
  <div class="container" style="max-width: 720px;">
    <header class="text-center mb-4">
      <div class="check-confirmacion mb-3"><i class="bi bi-check-lg"></i></div>
      <h1 class="h2 fw-bold m-0" style="color:#2c3e50;">Reserva registrada</h1>
      <p class="text-muted mt-2 mb-0">Tu solicitud quedó guardada. Puedes volver a consultarla en <em>Mis reservas</em>.</p>
    </header>

    <div class="tarjeta-reserva p-4 mb-4">
      <dl class="row mb-0">
        <dt class="col-sm-4">Sala</dt>
        <dd class="col-sm-8"><%= @espacio.nombre %> · <%= @espacio.ubicacion %></dd>

        <dt class="col-sm-4">Fecha</dt>
        <dd class="col-sm-8"><%= fecha_larga(@fecha) %></dd>

        <dt class="col-sm-4">Módulos</dt>
        <dd class="col-sm-8">
          <% @reservas.each do |r| %>
            <div><%= r.modulo.etiqueta %></div>
          <% end %>
        </dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8"><%= estado_badge(@estado_grupo) %></dd>
      </dl>

      <hr>
      <h2 class="h6 fw-bold mb-2"><i class="bi bi-signpost-2 me-1"></i>Instrucciones de acceso</h2>
      <%= render "espacios/ficha_sala", espacio: @espacio, solo_acceso: true %>
    </div>

    <div class="d-flex flex-wrap justify-content-center gap-2">
      <%= link_to mi_reserva_path(@grupo), class: "btn btn-primary fw-semibold px-4" do %>
        <i class="bi bi-eye me-1"></i>Ver mi reserva
      <% end %>
      <%= link_to espacios_path(fecha: @fecha), class: "btn btn-outline-secondary px-4" do %>
        <i class="bi bi-grid-3x3 me-1"></i>Volver a la disponibilidad
      <% end %>
    </div>
  </div>
</div>
