<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" %>

<div class="min-vh-100 py-5 bg-body-tertiary">
  <div class="container">
    <header class="text-center mb-4">
      <h2 class="display-6 fw-semibold mb-3"><i class="bi bi-plus-circle me-2"></i>Nueva reserva</h2>
      <p class="text-muted">Selecciona el <strong>espacio</strong>, <strong>módulo</strong> y <strong>fecha</strong> para crear tu nueva reserva.</p>
    </header>

    <% if @reserva.errors.any? %>
      <div class="alert alert-danger">
        <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Hay errores:</h6>
        <ul class="mb-0">
          <% @reserva.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width:700px; background-color:#f8f8f8;">
      <div class="card-body p-4">
        <%= form_with model: @reserva, url: reservas_path, local: true do |f| %>

          <% if @reserva.espacio.present? %>
            <div class="mb-4">
              <label class="form-label fw-semibold"><i class="bi bi-building me-2"></i>Espacio</label>
              <div class="p-3 rounded bg-body-secondary">
                <%= @reserva.espacio.nombre %>
                <%= f.hidden_field :espacio_id, value: @reserva.espacio.id %>
              </div>
            </div>
          <% else %>
            <div class="mb-4">
              <label class="form-label fw-semibold"><i class="bi bi-building me-2"></i>Espacio</label>
              <%= f.collection_select :espacio_id, @espacios, :id, :nombre, { prompt: "Selecciona un espacio" }, { class: "form-select" } %>
            </div>
          <% end %>

          <div class="mb-4">
            <label class="form-label fw-semibold"><i class="bi bi-clock me-2"></i>Módulo</label>
            <%= f.collection_select :modulo_id,
                                    @modulos,
                                    :id,
                                    ->(m){ "#{m.hora_inicio.strftime('%H:%M')} - #{m.hora_fin.strftime('%H:%M')}" },
                                    { prompt: "Selecciona un módulo" },
                                    { class: "form-select" } %>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold"><i class="bi bi-calendar-date me-2"></i>Fecha</label>
            <%= f.date_field :fecha, class: "form-control" %>
          </div>

          <div class="text-center mt-4">
            <%= f.submit "Reservar", class: "btn btn-success fw-bold px-4" %>
            <%= link_to "Volver", espacios_path, class: "btn btn-outline-dark fw-bold ms-2 px-4" %>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>

<%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" %>
