<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="bg-light p-4 rounded shadow mt-4 mb-5">
        <h2 class="mb-4 text-center">
          <span class="bg-primary text-white px-3 py-2 rounded d-inline-block">Iniciar sesión</span>
        </h2>

        <% if flash[:alert] %>
          <div class="alert alert-danger"><%= flash[:alert] %></div>
        <% end %>

        <%= form_with url: login_path, method: :post, local: true, class: "row g-3" do %>
          <div class="col-12">
            <label class="form-label">Email</label>
            <%= email_field_tag :email, nil, class: "form-control", required: true %>
          </div>

          <div class="col-12">
            <label class="form-label">Contraseña</label>
            <%= password_field_tag :password, nil, class: "form-control", required: true %>
          </div>

          <div class="col-12">
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
          </div>

          <div class="col-12 text-center mt-2">
            <%= link_to "¿No tienes cuenta? Regístrate", signup_path, class: "text-decoration-none" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
