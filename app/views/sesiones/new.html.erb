<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="bg-light p-4 rounded shadow mt-4 mb-5">
        <h2 class="mb-3 text-center">Entrar</h2>

        <div class="text-center mb-4">
          <%= button_to invitado_path, method: :post, class: "btn btn-primary btn-lg w-100" do %>
            <i class="bi bi-person me-1"></i>Entrar como invitado
          <% end %>
          <p class="small text-muted mt-2 mb-0">Sin crear cuenta. Tus reservas quedan asociadas a esta sesión.</p>
        </div>

        <div class="d-flex align-items-center my-3">
          <hr class="flex-grow-1"><span class="px-2 small text-muted">o con tu cuenta</span><hr class="flex-grow-1">
        </div>

        <%= form_with url: login_path, method: :post, local: true, class: "row g-3" do %>
          <div class="col-12">
            <label class="form-label" for="email">Email</label>
            <%= email_field_tag :email, nil, class: "form-control", required: true %>
          </div>

          <div class="col-12">
            <label class="form-label" for="password">Contraseña</label>
            <%= password_field_tag :password, nil, class: "form-control", required: true %>
          </div>

          <div class="col-12">
            <button type="submit" class="btn btn-outline-primary w-100">Iniciar sesión</button>
          </div>

          <div class="col-12 text-center mt-2">
            <%= link_to "¿No tienes cuenta? Regístrate", signup_path, class: "text-decoration-none" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
