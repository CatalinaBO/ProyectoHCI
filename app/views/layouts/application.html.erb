<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Bookify · Salas CAI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Bootstrap CSS + íconos -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    >
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "disponibilidad", "data-turbo-track": "reload" %>

    <script>
      window.App ||= {};
      const cableURL = document.querySelector("meta[name='action-cable-url']")?.content || "/cable";
      if (window.ActionCable) { App.cable = ActionCable.createConsumer(cableURL); }
    </script>
  </head>

  <body data-current-user-id="<%= current_user&.id %>">
    <%= render "layouts/navbar" %>

    <% if notice.present? || alert.present? %>
      <div class="container contenido-flash pt-3">
        <% if notice.present? %>
          <div class="alert alert-success alert-dismissible fade show mb-0" role="status">
            <i class="bi bi-check-circle me-1"></i><%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-warning alert-dismissible fade show mb-0 <%= 'mt-2' if notice.present? %>" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i><%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
