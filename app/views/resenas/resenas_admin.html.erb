<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" %>

<div class="min-vh-100 py-5 bg-body-tertiary">
  <div class="container">
    <header class="text-center mb-4">
      <h3 class="display-6 fw-semibold mb-3">
        <i class="bi bi-chat-text me-2"></i>Todas las Reseñas
      </h3>
      <p class="text-muted">Mira todas las reseñas que han registrado los usuarios para este espacio.</p>
    </header>

    <% if @espacio.present? %>
    <div class="d-flex justify-content-center mb-4">
        <div class="card shadow-sm border-0 rounded-4 p-4 w-100 mx-auto" style="max-width: 700px; background-color: #e9ecef;">
        <h5 class="fw-semibold mb-2">
            <i class="bi bi-building me-2"></i><%= @espacio.nombre %>
        </h5>
        <p class="mb-1">
            <i class="bi bi-tag me-1"></i><strong>Tipo:</strong> <%= @espacio.tipo %>
        </p>
        <% if @espacio.respond_to?(:ubicacion) && @espacio.ubicacion.present? %>
            <p class="mb-1">
            <i class="bi bi-geo-alt me-1"></i><strong>Ubicación:</strong> <%= @espacio.ubicacion %>
            </p>
        <% end %>
        <% if @espacio.respond_to?(:capacidad) && @espacio.capacidad.present? %>
            <p class="mb-0">
            <i class="bi bi-people me-1"></i><strong>Capacidad:</strong> <%= @espacio.capacidad %> personas
            </p>
        <% end %>
        </div>
    </div>
    <% end %>


    <% if @resenas.any? %>

      <div class="d-flex flex-column align-items-center gap-3">
        <% @resenas.each do |resena| %>
          <div class="card shadow-sm border-0 rounded-4 p-4 w-100" style="max-width: 700px; background-color: #f8f8f8;">

            <div class="d-flex justify-content-between align-items-start mb-2">
              <div class="fw-semibold d-flex align-items-center">
                <% 1.upto(5) do |i| %>
                  <i class="bi <%= i <= resena.rating ? 'bi-star-fill text-warning' : 'bi-star text-warning' %> fs-5 me-1"></i>
                <% end %>
              </div>

              <div>
                <%= button_to eliminar_resena_id_path(resena),
                            method: :delete,
                            data: { turbo_confirm: "¿Seguro?" },
                            class: "btn btn-sm btn-danger" do %>
                <i class="bi bi-trash-fill"></i>
              <% end %>

              </div>

            </div>

            <p class="mb-1"><%= resena.comentario %></p>

            <% if resena.respond_to?(:usuario) && resena.usuario.present? %>
              <p class="text-muted small mb-0">
                <i class="bi bi-person-circle me-1"></i>
                <%= resena.usuario.nombre if resena.usuario.respond_to?(:nombre) %>
              </p>
            <% end %>

            <% if resena.respond_to?(:created_at) %>
              <p class="text-muted small mb-0">
                <i class="bi bi-calendar-event me-1"></i>
                <%= resena.created_at.strftime("%d/%m/%Y") %>
              </p>
            <% end %>

          </div>
        <% end %>
      </div>

    <% else %>
      <div class="text-center text-muted mt-5">
        <i class="bi bi-emoji-frown fs-2 d-block mb-2"></i>
        <p class="fw-semibold">Aún no hay reseñas para este espacio.</p>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to '/espacios/index', class: "btn btn-outline-dark fw-bold px-4" do %>
        <i class="bi bi-arrow-left-circle me-1"></i>Volver
      <% end %>
    </div>
  </div>
</div>

<%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" %>
