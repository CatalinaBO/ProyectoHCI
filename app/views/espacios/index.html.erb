  <div class="row g-4">

    <div class="col-12 col-md-4">
      <%= link_to espacios_por_tipo_path(tipo: 'Sala de Estudio'), class: "text-decoration-none" do %>
        <div class="p-5 border rounded-4 text-center shadow-sm h-100">
          <div class="h4 mb-1">Salas de Estudio</div>
          <div class="text-muted"><%= (@counts['Sala de Estudio'] || 0) %> disponibles</div>
