<h3 class="map-title">Biblioteca Gauss</h3>
<div class="map-sub">1° Piso</div>

<div class="map-canvas">
  <div class="map-split">
    <div class="map-box text-center">
      <div class="mb-2 small text-muted">1–15</div>
      <div class="grid" style="--cols:5">
        <% 15.times do %><div class="cell cell-gray"></div><% end %>
      </div>
    </div>
    <div class="map-box text-center">
      <div class="mb-2 small text-muted">16–30</div>
      <div class="grid" style="--cols:5">
        <% 15.times do %><div class="cell cell-gray"></div><% end %>
      </div>
    </div>
  </div>

  <div class="mt-3 map-legend">
    1–15: capacidad S–M · 16–30: capacidad L
  </div>
</div>
