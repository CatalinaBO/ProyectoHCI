<h3 class="map-title">Biblioteca San Joaquín</h3>
<div class="map-sub">2° Piso</div>

<div class="map-canvas">
  
  <div class="map-split">
    <div class="map-box text-center">
      <div class="mb-2 small text-muted">1–15</div>
      <div class="grid" style="--cols:5">
        <% 15.times do %><div class="cell cell-gray"></div><% end %>
      </div>
    </div>
    <div class="map-box text-center">
      <div class="mb-2 small text-muted">16–30</div>
      <div class="grid" style="--cols:5">
        <% 15.times do %><div class="cell cell-gray"></div><% end %>
      </div>
    </div>
    <div class="map-box text-center">
      <div class="mb-2 small text-muted">31–40</div>
      <div class="grid" style="--cols:5">
        <% 10.times do %><div class="cell cell-gray"></div><% end %>
      </div>
    </div>
  </div>

  <div class="mt-3 map-legend">
    1–15: capacidad <strong>S</strong> · 16–30: <strong>M</strong> · 31–40: <strong>L</strong>
  </div>
</div>
