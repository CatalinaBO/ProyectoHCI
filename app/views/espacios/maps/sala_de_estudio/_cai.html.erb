<h3 class="map-title">CAI</h3>
<div class="map-sub">1° Piso</div>

<div class="map-canvas">
  
  <div class="grid" style="--cols:1">
    <% (1..3).each do |n| %><div class="cell cell-gray"><%= n %></div><% end %>
  </div>

  <div class="mt-3 map-legend">
    1–3: sala individual o grupal (según disponibilidad)
  </div>
</div>
