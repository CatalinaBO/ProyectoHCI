<h3 class="map-title">Biblioteca Gauss</h3>
<div class="map-sub">1° Piso</div>

<div class="map-canvas">

  <div class="map-split">
    <div class="map-box">
      
      <div class="grid" style="--cols:10">
        <% 10.times do %><div class="cell cell-red"></div><% end %>
      </div>
      <div class="d-flex gap-3 my-2">
        <div class="grid" style="--cols:2">
          <% 6.times do %><div class="cell cell-red"></div><% end %>
        </div>
        <div class="grid" style="--cols:4">
          <% 12.times do %><div class="cell cell-blue"></div><% end %>
        </div>
        <div class="grid" style="--cols:2">
          <% 6.times do %><div class="cell cell-red"></div><% end %>
        </div>
      </div>
      <div class="grid" style="--cols:10">
        <% 10.times do %><div class="cell cell-red"></div><% end %>
      </div>
      <div class="map-lbl">Azul: individuales · Rojo: grupales</div>
    </div>
  </div>

  <div class="mt-3 map-legend">
    <span class="swatch swatch-blue"></span> Mesa individual
    &nbsp;&nbsp;
    <span class="swatch swatch-red"></span> Mesa grupal
  </div>
</div>
