<h3 class="map-title">CAI</h3>
<div class="map-sub">1° Piso</div>

<div class="map-canvas">
  <div class="map-box">
    
    <div class="grid" style="--cols:12">
      <% 12.times do %><div class="cell cell-red"></div><% end %>
      <% 10.times do %><div class="cell cell-red"></div><% end %>
      <div></div><div></div>
      <% 8.times do %><div class="cell cell-blue"></div><% end %>
      <div></div><div></div>
      <% 10.times do %><div class="cell cell-red"></div><% end %>
      <% 12.times do %><div class="cell cell-red"></div><% end %>
    </div>
  </div>
  <div class="mt-3 map-legend">
    <span class="swatch swatch-blue"></span> Mesa individual
    &nbsp;&nbsp;
    <span class="swatch swatch-red"></span> Mesa grupal
  </div>
</div>
