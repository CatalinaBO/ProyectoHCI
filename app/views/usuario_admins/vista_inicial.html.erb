<!DOCTYPE html>
<html>
  <head>
    <title>Modo Administrador</title>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" %>

    <style>
      body {
        font-family: "Helvetica Neue", Arial, sans-serif;
        background-color: #f4f6f9;
        color: #333;
        margin: 0;
        padding: 0;
      }

      h1 {
        text-align: center;
        color: #2c3e50;
        margin-top: 50px;
        margin-bottom: 30px;
        font-size: 2.2em;
      }

      p.subtitulo {
        text-align: center;
        color: #282b2e;
        margin-bottom: 10px;
        font-size: 1.2em;
      }

      .contenedor-botones {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 30px;
        padding: 40px 0;
      }

      .boton-vertical {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 300px;
        height: 400px;
        background-color: #3b6796;
        color: white;
        border: none;
        border-radius: 15px;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s, background-color 0.2s;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      }

      .boton-vertical:hover {
        background-color: #315174;
        transform: scale(1.05);
      }

      .boton-vertical h3 {
        margin: 10px 0 5px 0;
        font-size: 20px;
      }

      .boton-vertical p {
        color: #eef0f1;
        margin: 0;
        font-size: 14px;
        opacity: 0.9;
        padding: 0 15px;
      }

      @media (max-width: 768px) {
        .boton-vertical {
          width: 90%;
          height: 350px;
        }
      }
    </style>
  </head>

  <body>

    <div class="container mt-4">
      <h1>Bienvenido Administrador!</h1>
      <h1 class="subtitulo"></h1>
      <p class="subtitulo">Selecciona la acción que desees realizar:</p>

      <div class="contenedor-botones">
        <%= link_to "/espacios/new", class: "boton-vertical" do %>
          <h3>Crear Espacio</h3>
          <p>Agrega un nuevo espacio para que los estudiantes puedan tener una mayor variedad de productos.</p>
        <% end %>

        <%= link_to "/espacios/index", class: "boton-vertical" do %>
          <h3>Ver Espacios</h3>
          <p>Revisa los espacios que ya se encuentran creados, junto con sus características.</p>
        <% end %>

        <%= link_to "/espacios/espacios_eliminar", class: "boton-vertical" do %>
          <h3>Eliminar Espacio</h3>
          <p>Elimina un espacio que consideres que ya no es adecuado para los estudiantes.</p>
        <% end %>

        <%= link_to '/reservas/reservas_pendientes', class: "boton-vertical" do %>
          <h3>Solicitudes de Reserva</h3>
          <p>Acepta o rechaza las reservas que han solicitado los estudiantes.</p>
        <% end %>
      </div>
    </div>

    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" %>
  </body>
</html>
