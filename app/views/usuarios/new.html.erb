<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="bg-light p-4 rounded shadow mt-4 mb-5">
        <h2 class="mb-4 text-center">
          <span class="bg-primary text-white px-3 py-2 rounded d-inline-block">Crear cuenta</span>
        </h2>

        <% if @usuario.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @usuario.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @usuario, class: "row g-3" do |f| %>
          <div class="col-md-6">
            <%= f.label :nombre, "Nombre", class: "form-label" %>
            <%= f.text_field :nombre, class: "form-control", required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :email, "Email", class: "form-label" %>
            <%= f.email_field :email, class: "form-control", required: true %>
          </div>

          <div class="col-12">
            <%= f.label :info_personal, "Información Personal", class: "form-label" %>
            <%= f.text_area :info_personal, class: "form-control", rows: 4, placeholder: "Tu Carrera, Edad..." %>
          </div>

          <div class="col-md-6">
            <%= f.label :password, "Contraseña", class: "form-label" %>
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :password_confirmation, "Confirmar contraseña", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", required: true %>
          </div>

          <div class="col-12">
            <button type="submit" class="btn btn-primary">Registrarse</button>
            <%= link_to "Volver al inicio", root_path, class: "btn btn-link" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>
