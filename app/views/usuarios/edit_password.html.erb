<div class="container mt-5">
  <div class="card shadow p-4 mx-auto" style="max-width: 500px;">
    <h2 class="text-center mb-4">Cambiar Contraseña</h2>

    <% if flash[:alert] %>
      <div class="alert alert-danger"><%= flash[:alert] %></div>
    <% end %>

    <% if @usuario.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% @usuario.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @usuario, url: actualizar_contrasena_path, method: :patch, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :current_password, "Contraseña actual", class: "form-label" %>
        <%= f.password_field :current_password, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Nueva contraseña", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirmar nueva contraseña", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", required: true %>
      </div>

      <div class="text-center">
        <%= f.submit "Actualizar contraseña", class: "btn btn-primary" %>
        <%= link_to "Volver", perfil_path, class: "btn btn-secondary ms-2" %>
      </div>
    <% end %>
  </div>
</div>
